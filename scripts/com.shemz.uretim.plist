<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shemz uretim zamanlayicisi.

  ⚠️ SHORTS BANDI 2 SAATLIK, GECE BANDI DEGIL — KASITLI (2026-08-23,
  kanal sahibinin karari):

      00:05 UZUN
      05:05 07:05 09:05 11:05 13:05 15:05 17:05 19:05 21:05  Shorts

  Gunde 1 uzun video + 9 Shorts. Gun 24 saat ve uzun slot 5 saatini yiyor,
  yani "tam 2 saatte bir" ile "uzun slota genis pencere" ayni anda
  saglanamaz; kanal sahibi olcumu gorup uzun slotu korumayi secti.

  Uzun slota ~5 saat veriliyor cunku olculen uzun koşum 100-210 dk surdu ve
  3 saatlik pencereye SIGMIYORDU: tasan koşum sonraki slotu "atlandi |
  onceki kosum suruyor" ile yakiyordu (20-21 Agu'da uc kez).

  ⚠️ Gece bandina Shorts KONMADI, gerekcesi olcum: 23:05 koşumu 1/4
  ihtimalle kilidi 00:05'e tasiyip uzun slotu yakardi, 03:05 ise uzun
  slotun IKINCI koşumunu oldururdu ("uzun israr et" devre disi kalirdi).

  ⚠️ TETIK SAYISI KOTAYI ZORLAMIYOR — eski gerekce CURUDU (2026-08-23).
  Burada "videos.insert 1600 birim -> gunde en fazla 6 yukleme" yaziyordu;
  Google'in belgesi `videos.insert`in AYRI bir kovasi oldugunu ve gunluk
  100 cagri verildigini soyluyor (maliyet 1 birim). Gerekcenin tamami
  `slot_karari.sh`teki `GUNLUK_YUKLEME_TAVANI` yorumunda.

  ⚠️ Bu dizi `scripts/slot_karari.sh` icindeki `TETIK_SAATLERI` ile AYNI
  olmak zorunda — `test_slot_karari.py` ikisini karsilastiriyor. Ayrisirsa
  `sonraki_tetige_kalan_dk` gercekte olmayan bir tetigi bekler.

  Kurulum:
      cp scripts/com.shemz.uretim.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.shemz.uretim.plist

  Durdurma (tek komut):
      launchctl unload ~/Library/LaunchAgents/com.shemz.uretim.plist

  Durum:
      launchctl list | grep shemz
      tail -f storage/youtube_automation/logs/zamanlayici.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shemz.uretim</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mirzasaribiyik/Projects/MoneyPrinterTurbo/scripts/uret.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mirzasaribiyik/Projects/MoneyPrinterTurbo</string>

    <!-- Saatin 5'inde, tam saat degil: baska bir zamanlanmis is ya da elle
         baslatilan bir koşum tam saatte yigilmasin.
         06/11/16/21 Shorts (2026-09-12: tasarruf icin 10 -> 5).
         ⚠️ 00:05 UZUN kol 2026-09-13'te KALDIRILDI: uzun videolar OpenMontage
         autopilot'undan geliyor (com.shemz.openmontage.autopilot).
         ⚠️ Bu dizi `scripts/slot_karari.sh` icindeki `TETIK_SAATLERI` ile
         AYNI olmak zorunda; `test_slot_karari.py` ikisini karsilastiriyor. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>5</integer></dict>
    </array>

    <!-- ⚠️ Yuklenince HEMEN calismasin: `launchctl load` bir video
         uretmeye baslasin istemiyoruz, kurulum bir uretim karari degil. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Betik kendi ozetini `zamanlayici.log`a yaziyor; bunlar launchd'nin
         kendi hatalari icin (betik hic calisamazsa orada gorunur). -->
    <key>StandardOutPath</key>
    <string>/Users/mirzasaribiyik/Projects/MoneyPrinterTurbo/storage/youtube_automation/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mirzasaribiyik/Projects/MoneyPrinterTurbo/storage/youtube_automation/logs/launchd.log</string>
</dict>
</plist>
