<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shemz uretim zamanlayicisi.

  ⚠️ IZGARA DUZENSIZ, ve bu KASITLI (2026-08-22, kanal sahibinin karari):

      00:05 UZUN · 05:05 · 08:05 · 11:05 · 14:05 · 17:05 · 20:05

  Gunde 1 uzun video + 6 Shorts. Uzun slota ~5 saat veriliyor cunku
  olculen uzun koşum 100-210 dk surdu ve 3 saatlik pencereye SIGMIYORDU:
  tasan koşum sonraki slotu "atlandi | onceki kosum suruyor" ile yakiyordu
  (20-21 Agu'da uc kez).

  ⚠️ TETIK SAYISI KOTADAN da gecmeli: `videos.insert` 1600 birim, gunluk
  kota 10.000 — yani GUNDE EN FAZLA 6 YUKLEME. 7 tetik tavanin bir ustunde
  ama olculen yayin orani (p = 0,16 / koşum) ile baglamiyor; tavan yine de
  `slot_karari.sh`te ONCEDEN sayiliyor.

  ⚠️ Bu dizi `scripts/slot_karari.sh` icindeki `TETIK_SAATLERI` ile AYNI
  olmak zorunda — `test_slot_karari.py` ikisini karsilastiriyor. Ayrisirsa
  `sonraki_tetige_kalan_dk` gercekte olmayan bir tetigi bekler.

  Kurulum:
      cp scripts/com.shemz.uretim.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.shemz.uretim.plist

  Durdurma (tek komut):
      launchctl unload ~/Library/LaunchAgents/com.shemz.uretim.plist

  Durum:
      launchctl list | grep shemz
      tail -f storage/youtube_automation/logs/zamanlayici.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shemz.uretim</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mirzasaribiyik/Projects/MoneyPrinterTurbo/scripts/uret.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mirzasaribiyik/Projects/MoneyPrinterTurbo</string>

    <!-- Saatin 5'inde, tam saat degil: baska bir zamanlanmis is ya da elle
         baslatilan bir koşum tam saatte yigilmasin.
         00 UZUN kol · 05/08/11/14/17/20 Shorts. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>5</integer></dict>
    </array>

    <!-- ⚠️ Yuklenince HEMEN calismasin: `launchctl load` bir video
         uretmeye baslasin istemiyoruz, kurulum bir uretim karari degil. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Betik kendi ozetini `zamanlayici.log`a yaziyor; bunlar launchd'nin
         kendi hatalari icin (betik hic calisamazsa orada gorunur). -->
    <key>StandardOutPath</key>
    <string>/Users/mirzasaribiyik/Projects/MoneyPrinterTurbo/storage/youtube_automation/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mirzasaribiyik/Projects/MoneyPrinterTurbo/storage/youtube_automation/logs/launchd.log</string>
</dict>
</plist>
